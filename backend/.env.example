# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=crm_db
DB_SYNCHRONIZE=false

# ==========================================
# JWT CONFIGURATION
# ==========================================
# IMPORTANTE: Altere este valor em produção!
JWT_SECRET=seu-super-secret-jwt-aqui-mude-em-producao-use-valor-aleatorio-longo
JWT_EXPIRATION=7d

# ==========================================
# APPLICATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info

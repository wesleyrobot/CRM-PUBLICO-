# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=crm_db
DB_SYNCHRONIZE=false
DB_POOL_MAX=20
DB_POOL_MIN=5

# ==========================================
# JWT CONFIGURATION
# ==========================================
# IMPORTANTE: OBRIGATÓRIO em produção! Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=seu-super-secret-jwt-aqui-mude-em-producao-use-valor-aleatorio-longo
JWT_EXPIRATION=1h
# Refresh token expira em 7 dias (hardcoded no serviço)

# ==========================================
# APPLICATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# SECURITY
# ==========================================
# CORS: origens permitidas (use * para dev, domínios específicos em produção)
CORS_ORIGIN=*

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info

# ==========================================
# REDIS CACHE
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_TTL=900

# ==========================================
# MONITORING & ERROR TRACKING
# ==========================================
# Sentry DSN (obtenha em https://sentry.io)
SENTRY_DSN=
APP_VERSION=1.0.0

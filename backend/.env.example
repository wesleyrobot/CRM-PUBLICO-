# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=crm_db
DB_SYNCHRONIZE=false

# ==========================================
# JWT CONFIGURATION
# ==========================================
# IMPORTANTE: Altere este valor em produção!
JWT_SECRET=seu-super-secret-jwt-aqui-mude-em-producao-use-valor-aleatorio-longo
JWT_EXPIRATION=7d

# ==========================================
# APPLICATION
# ==========================================
PORT=3000
NODE_ENV=development

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=info

# ==========================================
# REDIS CACHE
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_TTL=900

# ==========================================
# MONITORING & ERROR TRACKING
# ==========================================
# Sentry DSN (obtenha em https://sentry.io)
SENTRY_DSN=
APP_VERSION=1.0.0
